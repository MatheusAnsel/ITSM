# API
DATABASE_URL=postgresql://itsm:itsm@localhost:5432/itsm
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
SWAGGER_ENABLED=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
AUTO_CLOSE_INTERVAL_MINUTES=15
# Limite de requisições por IP. Só desligue em testes automatizados; a API recusa false em produção.
RATE_LIMIT_ENABLED=true

# Seed (na stack Docker, SEED_ON_START=true executa o seed ao subir a API)
SEED_ON_START=false
SEED_ADMIN_EMAIL=admin@itsm.local
SEED_ADMIN_PASSWORD=
# Usuários e ativos de demonstração; em produção só é aceito com DEMO_MODE=true
SEED_DEMO=false
# Instância pública de demonstração (veja docs/DEPLOY.md). DEMO_PASSWORD é a senha pública dos usuários de demonstração.
DEMO_MODE=false
DEMO_PASSWORD=
# Proxies confiáveis na frente da API (1 no Render); 0 em desenvolvimento
TRUST_PROXY=0

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Só na hospedagem (Vercel): NEXT_PUBLIC_API_URL=/api e API_PROXY_TARGET=https://sua-api.onrender.com
API_PROXY_TARGET=

# Docker Compose (banco). Use só letras e números na senha: ela vai dentro da DATABASE_URL.
POSTGRES_USER=itsm
POSTGRES_PASSWORD=
POSTGRES_DB=itsm
