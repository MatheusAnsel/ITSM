# API
DATABASE_URL=postgresql://itsm:itsm@localhost:5432/itsm
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
SWAGGER_ENABLED=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
AUTO_CLOSE_INTERVAL_MINUTES=15

# Seed
SEED_ADMIN_EMAIL=admin@itsm.local
SEED_ADMIN_PASSWORD=
# Usuários e ativos de demonstração; ignorado e recusado em produção
SEED_DEMO=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Docker Compose (banco)
POSTGRES_USER=itsm
POSTGRES_PASSWORD=
POSTGRES_DB=itsm
