{
  "name": "itsm",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Gestão de Chamados e Ativos de TI (ITSM)",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=24.9" },
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "build": "npm run build -w apps/api",
    "lint": "npm run lint -w apps/api",
    "typecheck": "npm run typecheck -w apps/api",
    "test": "npm run test -w apps/api",
    "db:generate": "npm run prisma:generate -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:deploy": "npm run prisma:deploy -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api"
  }
}
